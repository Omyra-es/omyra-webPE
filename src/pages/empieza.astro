---
// Alta online de Perú. La web no cobra ni crea cuentas: envía el alta a HubSpot y abre el pago de la pasarela.
// Configuración en src/content/site.ts (signup y hubspotSignup). Perú y España van separados.
import Base from '../layouts/Base.astro';
import { site, cta, signup, hubspot, hubspotSignup } from '../content/site';
import { pricing } from '../content/pricing';

const sectors = ['Centro de estética', 'Peluquería', 'Salón de uñas', 'Pestañas y cejas', 'Barbería', 'Masajes y bienestar', 'Peluquería y spa canino', 'Otro'];
const teams = ['Solo yo', '2 a 5 personas', '6 a 10 personas', 'Más de 10'];
const departments = ['Amazonas', 'Áncash', 'Apurímac', 'Arequipa', 'Ayacucho', 'Cajamarca', 'Callao', 'Cusco', 'Huancavelica', 'Huánuco', 'Ica', 'Junín', 'La Libertad', 'Lambayeque', 'Lima', 'Loreto', 'Madre de Dios', 'Moquegua', 'Pasco', 'Piura', 'Puno', 'San Martín', 'Tacna', 'Tumbes', 'Ucayali'];

// Pago online activo solo con clave pública de Culqi y dirección de la app. Mientras no, el alta es una solicitud y contactamos al cliente.
const online = Boolean(signup.culqiPublicKey && signup.endpoint);
const cfg = {
  termsVersion: signup.termsVersion,
  plan: signup.plan,
  payLink: signup.paymentLink && /^https:\/\//.test(signup.paymentLink) ? signup.paymentLink : null,
  emailParam: signup.paymentEmailParam,
  hs: hubspot.portalId && hubspotSignup.formId ? `${hubspot.endpoint}/${hubspot.portalId}/${hubspotSignup.formId}` : null,
  country: hubspotSignup.country,
  email: site.contact.email,
  online,
};
const provider = signup.paymentProvider ?? 'la pasarela de pago';
const stepNames = online ? ['Tu cuenta', 'Tu negocio', 'Comprobante', 'Revisa y paga'] : ['Tu cuenta', 'Tu negocio', 'Revisa y envía'];
---
<Base title="Empieza con Omyra · Alta online" description={`Date de alta en Omyra: ${pricing.full}, sin permanencia.`} noindex>
  <div class="shell bg-green is-dark">
  <div class="mini">
    <span>Omyra · <strong>{pricing.price}</strong> {pricing.period}, {pricing.tax}</span>
    <button type="button" id="miniBtn" aria-expanded="false" aria-controls="sum">Ver detalle</button>
  </div>
  <div class="wrap main">
    <section class="flow">
      <div class="intro">
        <p class="eyebrow">Alta online · Sin permanencia</p>
        <h1 class="intro__h">Empieza con Omyra <span class="firma">hoy</span></h1>
        <p class="intro__lead">Tú trabajas, tus clientes reservan. Deja tu Omyra listo hoy y empieza a recibir reservas con tu marca, sin permanencia y sin comisiones por reserva.</p>
        {!online && <p class="intro__soon"><span aria-hidden="true">✦</span> Por ahora, las altas las hacemos contigo: déjanos tus datos y te contactamos para activar tu Omyra. Desde el {signup.onlineFrom} podrás pagar online aquí mismo.</p>}
        <p class="intro__demo">¿Prefieres verlo antes? <a href={cta.demo.href}>Te lo enseñamos en una demo →</a><br />¿Dudas? Escríbenos a <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
      </div>

      <ol class="steps" aria-label="Pasos del alta">
        {stepNames.map((s, i) => (
          <li data-dot={i + 1}><span class="steps__n">Paso {i + 1}</span><span class="steps__l">{s}</span></li>
        ))}
      </ol>

      <div id="note" class="note-slot" role="status" aria-live="polite"></div>

      <form id="alta" novalidate>
        <div class="hp" aria-hidden="true"><label for="f-website">No llenes este campo</label><input id="f-website" name="website" tabindex="-1" autocomplete="off" /></div>

        <fieldset class="card" data-step="1" data-key="1" aria-labelledby="step-h1">
          <h2 class="card__h" id="step-h1">Tu cuenta</h2>
          <p class="card__sub">{online ? 'Con estos datos creamos tu acceso a Omyra. Después del pago te enviamos tus accesos a este correo y lo primero que harás será elegir tu contraseña.' : 'Con estos datos preparamos tu acceso a Omyra. Te contactamos para activarlo y te enviamos tus accesos a este correo.'}</p>
          <div class="f2">
            <div class="field"><label for="f-firstName">Nombre</label><input id="f-firstName" name="firstName" autocomplete="given-name" required /><p class="err" id="e-firstName"></p></div>
            <div class="field"><label for="f-lastName">Apellidos</label><input id="f-lastName" name="lastName" autocomplete="family-name" required /><p class="err" id="e-lastName"></p></div>
          </div>
          <div class="f2">
            <div class="field"><label for="f-email">Correo electrónico</label><input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required /><p class="err" id="e-email"></p></div>
            <div class="field"><label for="f-phone">Celular</label><div class="pre"><span aria-hidden="true">+51</span><input id="f-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" placeholder="987 654 321" required /></div><p class="err" id="e-phone"></p></div>
          </div>
          <div class="actions"><button type="button" class="next" data-next>Continuar <span aria-hidden="true">→</span></button></div>
          <p class="small">Al continuar guardamos estos datos para poder ayudarte si no terminas el alta. Solo te escribiremos sobre tu alta en Omyra. <a href="/privacidad">Privacidad</a>.</p>
        </fieldset>

        <fieldset class="card" data-step="2" data-key="2" aria-labelledby="step-h2" hidden>
          <h2 class="card__h" id="step-h2">Tu negocio</h2>
          <div class="field"><label for="f-businessName">Nombre del negocio</label><input id="f-businessName" name="businessName" autocomplete="organization" required aria-describedby="h-businessName" /><span class="hint" id="h-businessName">Es el nombre que verán tus clientes al reservar.</span><p class="err" id="e-businessName"></p></div>
          <div class="field" role="radiogroup" aria-labelledby="l-sector"><span class="lbl" id="l-sector">Sector</span>
            <div class="chips">{sectors.map((s) => <label><input type="radio" name="sector" value={s} required />{s}</label>)}</div>
            <p class="err" id="e-sector"></p></div>
          <div class="field" role="radiogroup" aria-labelledby="l-team"><span class="lbl" id="l-team">¿Cuántas personas atienden?</span>
            <div class="chips">{teams.map((s) => <label><input type="radio" name="teamSize" value={s} required />{s}</label>)}</div>
            <p class="err" id="e-teamSize"></p></div>
          <div class="field field--half"><label for="f-city">Ciudad o distrito</label><input id="f-city" name="city" autocomplete="address-level2" placeholder="Por ejemplo, Miraflores" required /><p class="err" id="e-city"></p></div>
          <div class="actions"><button type="button" class="back" data-back>← Atrás</button><button type="button" class="next" data-next>Continuar <span aria-hidden="true">→</span></button></div>
        </fieldset>

        {online && <fieldset class="card" data-step="3" data-key="3" aria-labelledby="step-h3" hidden>
          <h2 class="card__h" id="step-h3">Comprobante de pago</h2>
          <p class="card__sub">Para emitir cada mes tu comprobante electrónico de Omyra.</p>
          <div class="field" role="radiogroup" aria-labelledby="l-docType"><span class="lbl" id="l-docType">¿Qué comprobante necesitas?</span>
            <div class="chips">
              <label><input type="radio" name="docType" value="factura" required />Factura (con RUC)</label>
              <label><input type="radio" name="docType" value="boleta" required />Boleta (con DNI)</label>
            </div>
            <p class="err" id="e-docType"></p></div>
          <div class="f2">
            <div class="field"><label for="f-docNumber" id="l-docNumber">RUC</label><input id="f-docNumber" name="docNumber" autocomplete="off" inputmode="numeric" maxlength="13" required /><p class="err" id="e-docNumber"></p><p class="ok" id="ok-docNumber" hidden>✓ RUC correcto</p></div>
            <div class="field"><label for="f-legalName" id="l-legalName">Razón social</label><input id="f-legalName" name="legalName" required /><p class="err" id="e-legalName"></p></div>
          </div>
          <div class="field"><label for="f-address">Dirección fiscal</label><input id="f-address" name="address" autocomplete="street-address" placeholder="Av., calle o jirón, número, interior" required /><p class="err" id="e-address"></p></div>
          <div class="f3">
            <div class="field"><label for="f-department">Departamento</label><select id="f-department" name="department" required><option value="">Elige</option>{departments.map((d) => <option>{d}</option>)}</select><p class="err" id="e-department"></p></div>
            <div class="field"><label for="f-province">Provincia</label><input id="f-province" name="province" autocomplete="address-level2" required /><p class="err" id="e-province"></p></div>
            <div class="field"><label for="f-district">Distrito</label><input id="f-district" name="district" autocomplete="address-level3" required /><p class="err" id="e-district"></p></div>
          </div>
          <div class="actions"><button type="button" class="back" data-back>← Atrás</button><button type="button" class="next" data-next>Continuar <span aria-hidden="true">→</span></button></div>
        </fieldset>}

        <fieldset class="card card--review" data-step={online ? 4 : 3} data-key="4" aria-labelledby="step-h4" hidden>
          <h2 class="card__h" id="step-h4">{online ? 'Revisa y paga' : 'Revisa y envía'}</h2>
          <div class="review">
            <div class="rv"><h3>Tu cuenta</h3><p id="rv-1"></p><button type="button" data-goto="1">Cambiar</button></div>
            <div class="rv"><h3>Tu negocio</h3><p id="rv-2"></p><button type="button" data-goto="2">Cambiar</button></div>
            {online && <div class="rv"><h3>Comprobante</h3><p id="rv-3"></p><button type="button" data-goto="3">Cambiar</button></div>}
          </div>
          <div class="guide"><span class="guide__star" aria-hidden="true">✦</span><p><b>Lo dejas listo tú, paso a paso.</b> Al entrar, Omyra te guía para configurar tu página de reservas, tu horario, tus servicios y tu equipo. Es muy sencillo.<br /><span class="guide__help">¿Te surge alguna duda? Escríbenos a <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</span></p></div>
          <div class="field field--check"><input id="f-terms" name="terms" type="checkbox" required />{online
            ? <label for="f-terms">He leído y acepto las <a href="/condiciones-de-contratacion" target="_blank">condiciones de contratación</a> y el <a href="/encargo-del-tratamiento" target="_blank">encargo del tratamiento</a>, y la <a href="/privacidad" target="_blank">política de privacidad</a>.</label>
            : <label for="f-terms">He leído la <a href="/privacidad" target="_blank">política de privacidad</a> y acepto que Omyra use estos datos para contactarme y activar mi alta.</label>}<p class="err" id="e-terms"></p></div>
          {online && <div class="secure"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span>El pago lo procesa <b>{provider}</b> de forma segura. Los datos de tu tarjeta van directo a {provider}: Omyra no los ve ni los guarda.</span></div>}
          <div class="actions"><button type="button" class="back" data-back>← Atrás</button><button type="submit" class="next pay" id="pay">{online ? <>Ir al pago · {pricing.price}</> : 'Solicitar mi alta'} <span aria-hidden="true">→</span></button></div>
          <p class="small"><b>Protección de datos.</b> Titular del banco de datos: Magda Isabel Chaname Altamirano (Omyra). Finalidad: {online ? 'crear tu cuenta, cobrar la suscripción y emitir tu comprobante' : 'contactarte para activar tu alta en Omyra'}. Destinatarios: HubSpot, nuestra herramienta de contactos (servidores en la Unión Europea){online ? `, y ${provider}, que procesa el pago` : ''}. Puedes ejercer tus derechos de acceso, rectificación, cancelación y oposición escribiendo a <a href={`mailto:${site.contact.legalEmail}`}>{site.contact.legalEmail}</a>. Más información en la <a href="/privacidad">política de privacidad</a>.</p>
        </fieldset>
      </form>

      <section class="card done" id="done" hidden aria-live="polite">
        <span class="done__star" aria-hidden="true">✦</span>
        <h2 class="card__h" id="doneTitle" tabindex="-1">¡Listo!</h2>
        <p class="done__lead">Recibimos tu solicitud de alta. Te escribimos a <b id="doneEmail"></b> para activar tu Omyra y darte tus accesos.</p>
        <ul class="done__list" role="list">
          <li>Si te das de alta antes del {pricing.launchUntil}, mantienes {pricing.price} {pricing.period}, {pricing.tax}, mientras sigas suscrito.</li>
          <li>Por ahora las altas las hacemos contigo. Desde el {signup.onlineFrom} podrás pagar online aquí mismo.</li>
          <li>¿Prefieres adelantarte? Escríbenos a <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</li>
        </ul>
        <div class="actions"><button type="button" class="back" id="doneBack">← Revisar mis datos</button></div>
      </section>
    </section>

    <aside class="sum" id="sum" aria-label="Resumen del plan">
      <p class="eyebrow">Tu plan Omyra</p>
      <p class="sum__price"><span class="sum__num">{pricing.price}</span><span class="sum__per">{pricing.period}<br />{pricing.tax}</span></p>
      <p class="sum__launch">✦ {pricing.launchShort}</p>
      <div class="sum__today">
        {online && <div class="date" aria-hidden="true"><span class="date__m" id="dM"></span><span class="date__d" id="dD"></span></div>}
        <div class="sum__rows">
          <div><span>Plan mensual</span><span>{pricing.price}</span></div>
          <div><span>IGV</span><span>Incluido</span></div>
          <div class="sum__tot"><span>{online ? 'Hoy' : 'Al mes'}</span><span>{pricing.price}</span></div>
        </div>
      </div>
      <ul class="sum__list" role="list">
        <li id="dNext">{online ? 'Se renueva cada mes, el mismo día' : 'Se renueva cada mes, el mismo día en que se activa'}</li>
        <li>Si te suscribes antes del {pricing.launchUntil}, mantienes {pricing.price} mientras sigas suscrito. Después, {pricing.regularPrice} {pricing.period}.</li>
        <li>Sin permanencia: cancelas cuando quieras</li>
        <li>Todas las funcionalidades, profesionales ilimitados y sin comisiones de Omyra</li>
      </ul>
    </aside>
  </div>
  </div>

  <script is:inline type="application/json" id="alta-cfg" set:html={JSON.stringify(cfg)} />
</Base>

<script>
  import { validators, normalize, isValidRuc } from '../scripts/alta-validate';

  type Cfg = { termsVersion: string; plan: string; payLink: string | null; emailParam: string | null; hs: string | null; country: string; email: string; online: boolean };
  const cfg: Cfg = JSON.parse(document.getElementById('alta-cfg')!.textContent || '{}');
  const form = document.getElementById('alta') as HTMLFormElement;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
  const dots = [...document.querySelectorAll<HTMLLIElement>('[data-dot]')];
  const note = document.getElementById('note')!;
  const pay = document.getElementById('pay') as HTMLButtonElement;
  const done = document.getElementById('done')!;
  const KEY = 'omyra-alta';
  let step = 1;
  const N = steps.length; // 4 con pago online; 3 (sin comprobante) mientras el alta es una solicitud
  const keyOf = (n: number) => Number(steps[n - 1]?.dataset.key || n); // paso «canónico» para HubSpot

  // ---------- Fecha del cobro ----------
  const now = new Date();
  const dM = document.getElementById('dM'), dD = document.getElementById('dD');
  if (dM && dD) { dM.textContent = now.toLocaleDateString('es-PE', { month: 'short' }).replace('.', '').toUpperCase(); dD.textContent = String(now.getDate()); }
  if (cfg.online && now.getDate() <= 28) document.getElementById('dNext')!.textContent = `Se renueva el día ${now.getDate()} de cada mes`;

  // ---------- Resumen en celular ----------
  const miniBtn = document.getElementById('miniBtn')!;
  miniBtn.addEventListener('click', () => {
    const open = document.body.classList.toggle('sum-open');
    miniBtn.textContent = open ? 'Ocultar' : 'Ver detalle';
    miniBtn.setAttribute('aria-expanded', String(open));
  });

  // ---------- Campos ----------
  const fieldsOf = (n: number) => [...steps[n - 1].querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name]:not([name=website]), select[name]')];
  const byName = (name: string) => form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null;
  const valueOf = (name: string) => {
    const el = byName(name);
    if (!el) return '';
    if (el instanceof RadioNodeList) return el.value;
    return el.type === 'checkbox' ? (el.checked ? 'on' : '') : el.value.trim();
  };

  // Factura (RUC) o boleta (DNI): cambian las etiquetas del documento y del nombre.
  function syncDocType() {
    if (!document.getElementById('f-docNumber')) return; // sin paso de comprobante (alta por solicitud)
    const boleta = valueOf('docType') === 'boleta';
    document.getElementById('l-docNumber')!.textContent = boleta ? 'DNI' : 'RUC';
    document.getElementById('l-legalName')!.textContent = boleta ? 'Nombre completo' : 'Razón social';
    const doc = document.getElementById('f-docNumber') as HTMLInputElement;
    doc.maxLength = boleta ? 8 : 13;
    doc.placeholder = boleta ? '12345678' : '20123456789';
    document.getElementById('ok-docNumber')!.textContent = boleta ? '✓ DNI correcto' : '✓ RUC correcto';
  }

  function setError(name: string, msg: string) {
    const err = document.getElementById(`e-${name}`);
    if (err) err.textContent = msg;
    form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((el) => {
      if (el.type === 'radio') el.closest('.chips')?.toggleAttribute('data-invalid', Boolean(msg));
      else el.setAttribute('aria-invalid', String(Boolean(msg)));
      if (el.type !== 'radio') el.setAttribute('aria-describedby', [msg ? `e-${name}` : '', el.id === 'f-businessName' ? 'h-businessName' : ''].filter(Boolean).join(' '));
    });
    if (name === 'docNumber') document.getElementById('ok-docNumber')!.hidden = Boolean(msg) || !valueOf('docNumber');
  }
  function check(name: string) {
    const msg = validators[name]?.(valueOf(name), valueOf) ?? '';
    setError(name, msg);
    return !msg;
  }
  const names = (n: number) => [...new Set(fieldsOf(n).map((f) => f.name))];
  function checkStep(n: number) {
    const bad = names(n).filter((nm) => !check(nm));
    if (bad.length) focusField(bad[0]);
    return !bad.length;
  }
  function focusField(name: string) {
    const el = form.querySelector<HTMLElement>(`[name="${name}"]`);
    el?.focus({ preventScroll: true });
    el?.closest('.field')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  form.addEventListener('focusout', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name && t.name !== 'website' && t.type !== 'radio' && (t.value || t.getAttribute('aria-invalid') === 'true')) check(t.name);
  });
  form.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'docType') { syncDocType(); if (valueOf('docNumber')) check('docNumber'); if (valueOf('legalName')) check('legalName'); }
    if (t.type === 'radio' || t.type === 'checkbox' || t.tagName === 'SELECT') check(t.name);
    save();
  });
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.getAttribute('aria-invalid') === 'true') check(t.name);
    save();
  });

  // ---------- Guardado en el navegador (solo durante la visita) ----------
  function save() {
    const data: Record<string, string> = {};
    for (let n = 1; n <= N; n++) names(n).forEach((nm) => { if (nm !== 'terms') data[nm] = valueOf(nm); });
    try { sessionStorage.setItem(KEY, JSON.stringify({ data, step })); } catch { /* sin almacenamiento */ }
  }
  function restore() {
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      if (!saved) return 1;
      for (const [nm, v] of Object.entries(saved.data as Record<string, string>)) {
        const el = byName(nm);
        if (!el || !v) continue;
        el.value = v;
      }
      return Math.min(N, Math.max(1, Number(saved.step) || 1));
    } catch { return 1; }
  }

  // ---------- Pasos ----------
  function go(n: number, focus = true) {
    step = n;
    form.hidden = false;
    done.hidden = true;
    steps.forEach((s, i) => (s.hidden = i + 1 !== n));
    dots.forEach((d, i) => {
      d.dataset.s = i + 1 < n ? 'done' : i + 1 === n ? 'now' : '';
      if (i + 1 === n) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current');
    });
    if (n === N) fillReview();
    save();
    if (focus) document.querySelector('.steps')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  form.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', () => {
    if (!checkStep(step)) return;
    clearNote();
    track(keyOf(step + 1));
    go(step + 1);
  }));
  form.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', () => go(step - 1)));
  form.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.goto))));

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const fmtPhone = (p: string) => `+51 ${p.replace(/^(\d{3})(\d{3})(\d{3})$/, '$1 $2 $3')}`;
  function fillReview() {
    const v = valueOf;
    const doc = v('docType') === 'boleta' ? `Boleta · DNI ${normalize.doc(v('docNumber'))}` : `Factura · RUC ${normalize.doc(v('docNumber'))}`;
    document.getElementById('rv-1')!.innerHTML = esc(`${v('firstName')} ${v('lastName')} · ${normalize.email(v('email'))} · ${fmtPhone(normalize.phone(v('phone')))}`);
    document.getElementById('rv-2')!.innerHTML = esc(`${v('businessName')} · ${v('sector')} · ${v('teamSize')} · ${v('city')}`);
    const rv3 = document.getElementById('rv-3');
    if (rv3) rv3.innerHTML = `${esc(`${doc} · ${v('legalName')}`)}<br>${esc(`${v('address')}, ${v('district')}, ${v('province')} (${v('department')})`)}`;
  }

  // ---------- Avisos ----------
  const contact = `escríbenos a <a href="mailto:${cfg.email}">${cfg.email}</a>`;
  const notes: Record<string, [string, string, string]> = {
    cancelado: ['warn', 'No se te ha cobrado nada.', 'Volviste sin terminar el pago. Tus datos siguen aquí: revísalos y vuelve a intentarlo cuando quieras.'],
    campos: ['err', 'Revisa los campos marcados.', 'Te llevamos al primero que hay que corregir.'],
  };
  function showNote(kind: string) {
    const [tone, title, body] = notes[kind];
    note.innerHTML = `<div class="note note--${tone}"><b>${title}</b><span>${body}</span></div>`;
    note.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function clearNote() { note.innerHTML = ''; }

  // ---------- Origen de la visita ----------
  function source() {
    try {
      const s = JSON.parse(sessionStorage.getItem('omyra-origen') || '{}');
      return { ...s, landingPage: s.page || location.pathname, page: location.pathname };
    } catch { return { page: location.pathname }; }
  }

  // ---------- Altas a medias (HubSpot, con país Perú) ----------
  const STEP_NAMES = ['', 'Tu cuenta', 'Tu negocio', 'Comprobante', 'Revisa y paga', 'Ir al pago'];
  function track(reached: number) {
    // Solo desde omyra.pe: las pruebas en local o en vistas previas no crean contactos en HubSpot.
    if (!cfg.hs || valueOf('website') || !/(^|\.)omyra\.pe$/.test(location.hostname)) return;
    const src = source();
    const origin = [src.utm_source, src.utm_medium, src.utm_campaign, src.utm_content, src.ref && `ref:${src.ref}`, src.referrer].filter(Boolean).join(' · ') || 'directo';
    const phone = normalize.phone(valueOf('phone'));
    const fields = [
      ['firstname', valueOf('firstName')], ['lastname', valueOf('lastName')], ['email', normalize.email(valueOf('email'))],
      ['phone', phone ? `+51${phone}` : ''], ['company', valueOf('businessName')],
      ['paso_del_alta', `${reached} · ${STEP_NAMES[reached]}`], ['origen_del_alta', origin],
    ].filter(([, v]) => v).map(([name, value]) => ({ name, value }));
    const send = (extra: { name: string; value: string }[]) => fetch(cfg.hs!, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true,
      body: JSON.stringify({ fields: [...fields, ...extra], context: { pageUri: location.href.split('?')[0], pageName: 'Omyra Perú · Alta online' } }),
    });
    send([{ name: 'country', value: cfg.country }])
      .then((r) => { if (r.status === 400) return send([]); })
      .catch(() => { /* no bloquea el alta */ });
  }

  // ---------- Pago ----------
  function showDone() {
    form.hidden = true;
    done.hidden = false;
    clearNote();
    document.getElementById('doneEmail')!.textContent = normalize.email(valueOf('email'));
    const first = valueOf('firstName');
    document.getElementById('doneTitle')!.textContent = first ? `¡Listo, ${first}!` : '¡Listo!';
    dots.forEach((d) => { d.dataset.s = 'done'; d.removeAttribute('aria-current'); });
    document.querySelector('.steps')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    (document.getElementById('doneTitle') as HTMLElement).focus({ preventScroll: true });
  }
  document.getElementById('doneBack')!.addEventListener('click', () => go(N));

  const payLabel = pay.innerHTML;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (pay.disabled) return;
    for (let n = 1; n < N; n++) if (!names(n).every((nm) => !validators[nm]?.(valueOf(nm), valueOf))) { go(n); checkStep(n); showNote('campos'); return; }
    if (!check('terms')) { focusField('terms'); return; }
    if (valueOf('website')) return; // robot
    track(5);
    if (!cfg.payLink) { showDone(); return; }
    pay.disabled = true;
    pay.textContent = 'Abriendo el pago…';
    const url = new URL(cfg.payLink);
    if (cfg.emailParam) url.searchParams.set(cfg.emailParam, normalize.email(valueOf('email')));
    location.href = url.href;
  });
  window.addEventListener('pageshow', (e) => { if (e.persisted) { pay.disabled = false; pay.innerHTML = payLabel; } });

  // ---------- Inicio ----------
  const start = restore();
  syncDocType();
  const params = new URLSearchParams(location.search);
  if (params.get('pago') === 'cancelado') {
    go(N, false);
    showNote('cancelado');
  } else go(start, false);
  // Si vuelve con datos guardados, marca de nuevo lo que ya estaba mal.
  for (let n = 1; n < step; n++) names(n).forEach((nm) => { if (valueOf(nm)) check(nm); });
  void isValidRuc;
</script>

